
## Start of default rc

[sip]
contact="DzCentrex" <sip:dzcentrex@unknown-host>
# DzCentrex : pas d IPv6 (coupure à 32 s constatée avant Kamailio, et pas d IPv6 en Algérie).
use_ipv6=0
keepalive_period=30000
sip_port=-1
sip_tcp_port=-1
sip_tls_port=-1
media_encryption=none
update_presence_model_timestamp_before_publish_expires_refresh=1
use_rfc2833=1
use_info=1

[net]
#Because dynamic bitrate adaption can increase bitrate, we must allow "no limit"
download_bw=0
upload_bw=0

[video]
size=vga
automatically_accept=1
automatically_initiate=0
automatically_accept_direction=2 #receive only

[app]
# DzCentrex : service gardé actif (en plus du push).
keep_service_alive=1
tunnel=disabled
auto_download_incoming_voice_recordings=1
auto_download_incoming_icalendars=1

[tunnel]
host=
port=443

[misc]
max_calls=10
history_max_size=100
conference_layout=1
hide_empty_chat_rooms=1

[fec]
fec_enabled=1

[magic_search]
return_empty_friends=1

[chat]
imdn_to_everybody_threshold=1

[ui]
# DzCentrex : pas de création de compte linphone.org, pas de réunions (non prises en charge par le serveur).
assistant_hide_create_account=1
disable_meetings_feature=1
contacts_filter=


## End of default rc
